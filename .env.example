# Copy this file to .env and fill in your own values. Never commit a real .env file.
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# BetterAuth session secret. BETTER_AUTH_SECRET takes precedence; JWT_SECRET
# is kept only as a fallback so an existing deployment does not break on
# upgrade. Set one of them to a long random value in production.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
JWT_SECRET=
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NODE_ENV=development
